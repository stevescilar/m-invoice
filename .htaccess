<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive files if document root is not set to /public
    RewriteRule ^(\.env|composer\.(json|lock)|package(-lock)?\.json|artisan|.*\.sql|.*\.txt)$ - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L,NC]

    # Forward all requests to the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<FilesMatch "^\.env|composer\.(json|lock)|\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>

